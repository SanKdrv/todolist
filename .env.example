# Copy to .env and adjust values
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (docker-compose)
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy URL used by the backend and Alembic (sync psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://taskflow:taskflow@localhost:5432/taskflow

# Anonymous browser sessions (cookie Max-Age == server TTL: 30 days)
SESSION_TTL_DAYS=30
SESSION_TOUCH_INTERVAL_MINUTES=60
SESSION_CLEANUP_INTERVAL_MINUTES=60
SESSION_COOKIE_NAME=tf_session
# Must be true in production (validated at startup)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
