# Copy to .env.prod on the server: cp .env.prod.example .env.prod
# Never commit .env.prod. chmod 600 .env.prod

# Bootstrap PostgreSQL superuser. It is used only by the postgres container
# for initialization and administrative operations; the backend does not use it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-bootstrap-password
POSTGRES_DB=taskflow

# Password for the least-privileged application role taskflow_app.
# deploy/postgres/init-app-role.sh creates the role on the first initialization
# of an empty PostgreSQL volume.
APP_DB_PASSWORD=replace-with-a-strong-app-password

# The backend connects as taskflow_app, not as the bootstrap superuser.
# If the password contains URL-reserved characters, percent-encode it here
# (for example @ -> %40, : -> %3A). It must match APP_DB_PASSWORD.
DATABASE_URL=postgresql+psycopg://taskflow_app:replace-with-a-strong-app-password@db:5432/taskflow

# Punycode form of the Cyrillic domain. Caddy needs the ASCII form.
DOMAIN=xn----8sbafmcbeon8ceb3bnc.xn--p1ai

# Let's Encrypt account email (required for certificate issuance).
ACME_EMAIL=admin@example.com
